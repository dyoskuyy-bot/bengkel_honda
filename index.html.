
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tur Virtual 3D Bangunan</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #101820;
  color: white;
  text-align: center;
}

header {
  padding: 22px 10px;
}

header h1 {
  font-size: 25px;
  margin-bottom: 8px;
}

header p {
  color: #b8c5d1;
  font-size: 14px;
}

.viewer {
  width: 94%;
  height: 65vh;
  min-height: 350px;
  max-height: 600px;
  margin: 15px auto;
  overflow: hidden;
  border-radius: 15px;
  border: 2px solid #52616b;
  perspective: 1000px;
  background: #263746;
  touch-action: none;
}

#scene {
  width: 100%;
  height: 100%;
  background-image: url("foto-bangunan.jpg");
  background-size: cover;
  background-position: center;
  transform: scale(1.35);
  transition: transform 0.15s ease-out;
  will-change: transform;
}

.controls {
  padding: 15px;
}

button {
  padding: 13px 19px;
  margin: 5px;
  border: none;
  border-radius: 9px;
  background: #1686d9;
  color: white;
  font-size: 15px;
}

button:active {
  background: #075b99;
}

.info {
  padding: 15px;
  color: #cbd5df;
  font-size: 13px;
}
</style>
</head>

<body>

<header>
  <h1>TUR VIRTUAL 3D</h1>
  <p>Jelajahi bangunan secara interaktif</p>
</header>

<div class="viewer" id="viewer">
  <div id="scene"></div>
</div>

<div class="controls">
  <button onclick="resetView()">Reset Tampilan</button>
  <button onclick="zoomIn()">Perbesar +</button>
  <button onclick="zoomOut()">Perkecil -</button>
</div>

<div class="info">
  Geser foto ke kanan, kiri, atas, atau bawah untuk melihat area foto.
  <br><br>
  Gunakan tombol untuk mengatur tampilan.
</div>

<script>
const viewer = document.getElementById("viewer");
const scene = document.getElementById("scene");

let x = 0;
let y = 0;
let zoom = 1.35;
let startX = 0;
let startY = 0;
let dragging = false;

function updateView() {
  scene.style.transform =
    `translate(${x}px, ${y}px) scale(${zoom})`;
}

viewer.addEventListener("pointerdown", e => {
  dragging = true;
  startX = e.clientX - x;
  startY = e.clientY - y;
  viewer.setPointerCapture(e.pointerId);
});

viewer.addEventListener("pointermove", e => {
  if (!dragging) return;
  x = e.clientX - startX;
  y = e.clientY - startY;
  updateView();
});

viewer.addEventListener("pointerup", () => {
  dragging = false;
});

viewer.addEventListener("pointercancel", () => {
  dragging = false;
});

function resetView() {
  x = 0;
  y = 0;
  zoom = 1.35;
  updateView();
}

function zoomIn() {
  zoom = Math.min(zoom + 0.15, 2.5);
  updateView();
}

function zoomOut() {
  zoom = Math.max(zoom - 0.15, 1);
  updateView();
}
</script>

</body>
  </html>
  
